{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(melos *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git restore*)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(mkdir *)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(git stash*)",
      "Bash(git merge-base*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api repos/aktasilyas/pdf-drawing-tool/*)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "WebSearch",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Read(./example_app/.env)",
      "Read(./**/.env)",
      "Read(./docs/archive/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "dart \"$CLAUDE_PROJECT_DIR/tool/hooks/format_on_edit.dart\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart tool/hooks/stop_gate.dart", "timeout": 900 }
        ]
      }
    ]
  }
}
